# ============================================
# ORBITAL-X Environment Configuration
# ============================================

# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbital_x
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=orbital_x
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
COMMAND_STREAM_NAME=commands:stream
COMMAND_RESULT_STREAM_NAME=command-results:stream
COMMAND_RESULT_GROUP=backend-command-results

# ============================================
# AUTHENTICATION
# ============================================
# Production refuses missing secrets and the development/template defaults.
# Replace this with a private, randomly generated signing secret before deployment.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# BACKEND SERVER
# ============================================
BACKEND_URL=http://localhost:3000
BACKEND_PORT=3000
NODE_ENV=development
# Comma-separated reverse proxy IP addresses/CIDRs; empty means no trusted proxies.
# Configure only proxies you control that overwrite or append the real client IP.
# Example for a loopback-only proxy: TRUSTED_PROXIES=127.0.0.1/32,::1/128
TRUSTED_PROXIES=

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:3000
# Backend telemetry WebSocket endpoint (TELEMETRY_WEBSOCKET_PATH, default /ws)
VITE_WS_URL=ws://localhost:3000/ws
VITE_APP_NAME=ORBITAL-X

# ============================================
# AI SERVICE
# ============================================
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=65000
AI_SERVICE_PORT=8000

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# Alternative: Use local Ollama
# LLM_PROVIDER=ollama
# LLM_OLLAMA_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# ============================================
# SIMULATOR
# ============================================
SIMULATOR_PORT=8001
SIMULATOR_TELEMETRY_INTERVAL=1000
SIMULATOR_DEFAULT_SPEED=1

# ============================================
# ML CONFIGURATION
# ============================================
ML_MODEL_PATH=./models/anomaly_detector.joblib
ML_SCALER_PATH=./models/scaler.joblib
ML_TRAINING_DATA_PATH=./data/training
ML_EVALUATION_DATA_PATH=./data/evaluation

# ============================================
# RAG CONFIGURATION
# ============================================
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=300000
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
